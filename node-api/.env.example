# API v5 environment variables
# Copy to .env and fill in

# SQLite database path
DATABASE_URL="file:./dev.db"

# HMAC key for device claim signatures (must match hmac_key in firmware/secrets.ini)
HMAC_KEY=change-me-dev-hmac

# Firmware <= v36 signs claims with device uptime instead of unix ms; set to false once all devices are updated
ALLOW_LEGACY_CLAIM_TIMESTAMPS=true

# POST /device-claims/:code/attach limit, per service token per minute
ATTACH_RATE_LIMIT_PER_MINUTE=120

# Device endpoint limits per minute (a fleet of devices can share one NAT IP)
CLAIM_RATE_LIMIT_PER_IP_PER_MINUTE=1500
CLAIM_RATE_LIMIT_PER_MAC_PER_MINUTE=30
POLL_RATE_LIMIT_PER_CODE_PER_MINUTE=60
POLL_UNKNOWN_CODES_PER_IP_PER_MINUTE=30
HEARTBEAT_RATE_LIMIT_PER_DEVICE_PER_MINUTE=60

# Proxies whose X-Forwarded-For is trusted for client IP (rate limits). true / false / proxy-addr list
TRUST_PROXY=loopback,linklocal,uniquelocal

# JWT secret (unused in v5, kept for compatibility)
JWT_SECRET=change-me-dev

# OTA firmware settings
LATEST_FIRMWARE_VERSION=3
FIRMWARE_DOWNLOAD_URL=https://rd1-io.github.io/tigermeter-api/firmware/prod

# Service-to-service auth tokens — JSON array
# scope: "ops" (full access, fleet admin) or "manage" (tenant-scoped)
SERVICE_TOKENS='[
  {"token":"sk-ops-XXX","tenantId":"ops","scope":"ops"},
  {"token":"sk-tigermeter-YYY","tenantId":"tigermeter","scope":"manage"}
]'

# CORS allowed origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=http://localhost:5173
