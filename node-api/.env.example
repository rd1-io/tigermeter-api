# API v5 environment variables
# Copy to .env and fill in

# SQLite database path
DATABASE_URL="file:./dev.db"

# HMAC key for device claim signatures
HMAC_KEY=change-me-dev-hmac

# JWT secret (unused in v5, kept for compatibility)
JWT_SECRET=change-me-dev

# OTA firmware settings
LATEST_FIRMWARE_VERSION=3
FIRMWARE_DOWNLOAD_URL=https://rd1-io.github.io/tigermeter-api/firmware/prod

# Service-to-service auth tokens — JSON array
# scope: "ops" (full access, fleet admin) or "manage" (tenant-scoped)
SERVICE_TOKENS='[
  {"token":"sk-ops-XXX","tenantId":"ops","scope":"ops"},
  {"token":"sk-tigermeter-YYY","tenantId":"tigermeter","scope":"manage"}
]'

# CORS allowed origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=http://localhost:5173