# Deploy .env for the tigermeter docker stack (deployed to /opt/gateway/tigermeter/.env on CT 104)
# Copy to /opt/gateway/tigermeter/.env on the server

# HMAC key for device claim signatures (must match firmware build flag HMAC_KEY)
HMAC_KEY=tigermeter-prod-hmac-key-2026

# OTA firmware settings
LATEST_FIRMWARE_VERSION=36
FIRMWARE_DOWNLOAD_URL=https://rd1-io.github.io/tigermeter-api/firmware/prod

# CORS allowed origins (web admin)
CORS_ALLOWED_ORIGINS=https://app-tiger.rd1.io

# Service-to-service auth tokens — JSON array (no user JWTs in v5)
# scope: "ops" (full fleet admin) / "manage" (tenant-scoped)
# Generate new values with: openssl rand -hex 16
SERVICE_TOKENS='[
  {"token":"sk-ops-REPLACE_ME","tenantId":"ops","scope":"ops"},
  {"token":"sk-tigermeter-REPLACE_ME","tenantId":"tigermeter","scope":"manage"}
]'
